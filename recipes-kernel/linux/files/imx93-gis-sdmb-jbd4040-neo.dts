 * Device Tree for JBD4040 MicroLED in MIPI Command Mode (60Hz)
 */

#include "imx93-gis-sdmb.dts"

&lvds_bridge {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&dphy {
	status = "okay";
};

&dsi {
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			dsi_to_panel: endpoint {
				remote-endpoint = <&panel_to_dsi>;
			};
		};
	};

	panel@0 {
		reg = <0>;
		compatible = "gis,jbd4040-cm-60hz";

		/* 
		 * 在 Command Mode 下，由 DRM Panel 驅動 (panel-jbd4040.ko)
		 * 統一控制上電時序與復位
		 */
		avdd-gpios  = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		avee-gpios  = <&gpio2 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 24 GPIO_ACTIVE_LOW>;

		/* 關聯 I2C 匯流排，供 DRM 驅動內部讀寫暫存器 (亮度/白平衡/溫度等) */
		ddc-i2c-bus = <&lpi2c3>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_jbdpmic>;

		ports {
			port@1 {
				panel_to_dsi: endpoint {
					remote-endpoint = <&dsi_to_panel>;
				};
			};
		};
	};
};

&lcdif {
	/* 
	 * 1. VIDEO_PLL 設為 486000000 
	 * 2. PIX_CLK 設為 16200000 (16.2MHz)
	 */
	assigned-clock-rates = <486000000>, 
	                       <16200000>, 
	                       <400000000>, 
	                       <133333333>;
	status = "okay";
};

&lpi2c3 {
	jbd4040: panel_r@58 {
		compatible = "gis,jbd4040_i2c_neo";
		reg = <0x58>;
		status = "okay";

		regmap {
			luminance@200a14 {
				reg = <0x200a14>;
				bitmask = <0x00001fff>;
				label = "luminance";
			};
			current@200100 {
				reg = <0x200100>;
				bitmask = <0x000000ff>;
				label = "current";
			};
			temperature@200404 {
				reg = <0x200404>;
				bitmask = <0x000003ff>;
				label = "temperature";
			};
			flip@20020e {
				reg = <0x20020e>;
				bitmask = <0x00000002>;
				label = "flip";
			};
			mirror@20020e {
				reg = <0x20020e>;
				bitmask = <0x00000001>;
				label = "mirror";
			};
			offset@200a24 {
				reg = <0x200a24>;
				bitmask = <0x00001f1f>;
				label = "offset";
			};
			fps@200a00 {
				reg = <0x200a00>;
				bitmask = <0x00000007>;
				label = "fps"; 
			};
		};
	};

	panel_g@59 {
		compatible = "gis,jbd4040_i2c_59_dummy";
		reg = <0x59>;
		status = "okay";
	};
	panel_g@5a {
		compatible = "gis,jbd4040_i2c_5a_dummy";
		reg = <0x5a>;
		status = "okay";
	};
	panel_g@5b {
		compatible = "gis,jbd4040_i2c_5b_dummy";
		reg = <0x5b>;
		status = "okay";
	};
};

&iomuxc {
	pinctrl_jbdpmic: jbdpmicgrp {
		fsl,pins = <
			MX93_PAD_GPIO_IO03__GPIO2_IO03 	0x40000041
			MX93_PAD_GPIO_IO04__GPIO2_IO04 	0x40000041
			MX93_PAD_GPIO_IO24__GPIO2_IO24 	0x40000041
		>;
	};
};
